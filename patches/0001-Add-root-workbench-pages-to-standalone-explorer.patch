+
+function entityTopoCypherQuery(limit: number) {
+  return `.topo | graph-call cypher(\`MATCH (src)-[r]->(dest) RETURN properties(src) AS src, properties(r) AS relation, properties(dest) AS dest LIMIT ${limit}\`) | limit ${limit}`
+}
