+}
+
+export interface EntityTopoNode {
+  id: string
+  endpoint: EntityEndpoint
+  title: string
+  titleSource?: string
+  subtitle: string
+  searchText: string
+  visual: TopoTypeVisual
+  properties: Record<string, unknown>
+  inDegree: number
+  outDegree: number
