From ef163ec37745cca7459c4088cc6bfade47a341ad Mon Sep 17 00:00:00 2001
From: jkhkjlkll <jkhkjlkll@users.noreply.github.com>
Date: Mon, 22 Jun 2026 17:19:53 +0800
Subject: [PATCH] Match relation label styling

---
 src/features/topology/TopologyCanvas.tsx | 27 +++++++++++++----------
 src/features/topology/topology.css       | 27 +++++++++++++----------
 src/features/umodel/umodel.css           | 28 +++++++++++++++++++-----
 3 files changed, 53 insertions(+), 29 deletions(-)

diff --git a/src/features/topology/TopologyCanvas.tsx b/src/features/topology/TopologyCanvas.tsx
index 20e4034..9c267ee 100644
--- a/src/features/topology/TopologyCanvas.tsx
+++ b/src/features/topology/TopologyCanvas.tsx
@@ -1,4 +1,4 @@
-import { useEffect, useMemo, useRef, useState, type PointerEvent as ReactPointerEvent } from 'react'
+import { useEffect, useMemo, useRef, useState, type CSSProperties, type PointerEvent as ReactPointerEvent } from 'react'
 import { Graph, type GraphConfigInterface } from '@cosmos.gl/graph'
 import type { TopologyEdge, TopologyExplorerData, TopologyNode } from './topologyModel'
 import { drawTopologyPresetGlyph, resolveTopologyNodeIconPreset, TopologyPresetIcon } from './topologyIcons'
@@ -559,7 +559,7 @@ function CosmosEdgeLabels({
           <span
             key={label.id}
             className={`topo-cosmos-edge-label ${active ? 'active' : ''}`}
-            style={{ left, top, borderColor: label.color }}
+            style={{ left, top, '--topo-edge-label-color': label.color } as CSSProperties}
           >
             {label.label}
           </span>
@@ -1610,27 +1610,30 @@ function drawEdgeLabel(
 ) {
   const text = label || '关系'
   context.save()
-  context.font = `${active ? 11 : 10}px var(--om-cjk-font)`
+  context.font = `${active ? '700 11px' : '650 10px'} -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif`
   context.textBaseline = 'middle'
   context.textAlign = 'center'
-  const width = Math.min(context.measureText(text).width + 16, 132)
-  const height = active ? 20 : 18
+  const width = Math.min(context.measureText(text).width + 18, 180)
+  const height = active ? 22 : 20
   const box = { x: x - width / 2, y: y - height / 2, width, height }
   if (labelBoxes.some((current) => rectanglesOverlap(current, box))) {
     context.restore()
     return false
   }
   labelBoxes.push(box)
-  context.globalAlpha = active ? 0.96 : 0.82
-  roundRect(context, box.x, box.y, box.width, box.height, 4)
-  context.fillStyle = active ? '#ffffff' : 'rgba(255, 255, 255, 0.86)'
+  context.globalAlpha = 1
+  context.shadowColor = active ? 'rgba(15, 23, 42, 0.12)' : 'rgba(15, 23, 42, 0.08)'
+  context.shadowBlur = active ? 18 : 12
+  context.shadowOffsetY = active ? 8 : 5
+  roundRect(context, box.x, box.y, box.width, box.height, 8)
+  context.fillStyle = active ? '#ffffff' : 'rgba(255, 255, 255, 0.94)'
   context.fill()
-  context.strokeStyle = color
-  context.globalAlpha = active ? 0.9 : 0.38
+  context.shadowColor = 'transparent'
+  context.strokeStyle = active ? color : 'rgba(100, 116, 139, 0.18)'
   context.lineWidth = 1
   context.stroke()
-  context.globalAlpha = active ? 1 : 0.78
-  context.fillStyle = active ? '#273244' : '#657285'
+  context.globalAlpha = 1
+  context.fillStyle = active ? '#1e293b' : '#64748b'
   const clipped = text.length > 18 ? `${text.slice(0, 16)}...` : text
   context.fillText(clipped, x, y + 0.5, width - 12)
   context.restore()
diff --git a/src/features/topology/topology.css b/src/features/topology/topology.css
index d10cfd0..888f453 100644
--- a/src/features/topology/topology.css
+++ b/src/features/topology/topology.css
@@ -628,18 +628,20 @@
 
 .topo-cosmos-edge-label {
   position: absolute;
-  max-width: 150px;
-  transform: translate(-50%, -50%);
+  max-width: 180px;
+  display: flex;
+  align-items: center;
+  transform: translate3d(-50%, -50%, 0);
   overflow: hidden;
-  padding: 2px 7px;
-  border: 1px solid rgba(102, 112, 133, 0.28);
-  border-radius: 4px;
-  background: rgba(255, 255, 255, 0.82);
-  box-shadow: 0 3px 10px rgba(31, 45, 75, 0.08);
-  color: #667085;
+  padding: 3px 7px;
+  border: 1px solid rgba(100, 116, 139, 0.18);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.94);
+  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
+  color: #64748b;
   font-size: 10px;
   font-weight: 650;
-  line-height: 14px;
+  line-height: 1.3;
   text-overflow: ellipsis;
   white-space: nowrap;
 }
@@ -647,8 +649,11 @@
 .topo-cosmos-edge-label.active {
   z-index: 2;
   background: #ffffff;
-  color: #273244;
-  box-shadow: 0 5px 16px rgba(31, 45, 75, 0.14);
+  border-color: color-mix(in srgb, var(--topo-edge-label-color, #64748b) 48%, transparent);
+  color: #1e293b;
+  box-shadow:
+    0 0 0 3px color-mix(in srgb, var(--topo-edge-label-color, #64748b) 12%, transparent),
+    0 16px 34px rgba(15, 23, 42, 0.12);
 }
 
 .topo-cosmos-label {
diff --git a/src/features/umodel/umodel.css b/src/features/umodel/umodel.css
index b51d5fe..e6a295e 100644
--- a/src/features/umodel/umodel.css
+++ b/src/features/umodel/umodel.css
@@ -2738,19 +2738,35 @@ body.ume-resizing-detail .ume-detail-panel {
 
 .ume-opentopox-container .topo-edge-label {
   display: block;
-  fill: #667085;
-  stroke: rgba(255, 255, 255, 0.94);
-  stroke-width: 3.6px;
+  fill: #52677c;
+  stroke: #ffffff;
+  stroke-linejoin: round;
+  stroke-width: 4px;
   font-family: var(--ume-font-sans);
-  font-size: 10px;
+  font-size: 11px;
   font-weight: 650;
   paint-order: stroke;
   pointer-events: none;
+  transition: opacity 160ms ease, fill 160ms ease, stroke-width 160ms ease;
 }
 
 .ume-opentopox-wrap[data-zoom="mini"] .topo-edge-label {
-  font-size: 8px;
-  opacity: 0.68;
+  font-size: 9px;
+  opacity: 0.62;
+  stroke-width: 3.25px;
+}
+
+.ume-opentopox-wrap[data-zoom="compact"] .topo-edge-label {
+  font-size: 10px;
+  opacity: 0.78;
+}
+
+.ume-opentopox-container .topo-edge.is-selected .topo-edge-label,
+.ume-opentopox-container .topo-edge.is-multi-selected .topo-edge-label,
+.ume-opentopox-container .new-topo-graph.has-hover-highlight .topo-edge.is-hover-related .topo-edge-label {
+  fill: #334155;
+  opacity: 1;
+  stroke-width: 4.4px;
 }
 
 .ume-opentopox-wrap[data-focus-active="true"] .topo-edge:not(.is-multi-selected) .topo-edge-label {
-- 
