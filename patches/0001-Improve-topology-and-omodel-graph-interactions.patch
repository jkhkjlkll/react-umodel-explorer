+    : normalized.padEnd(6, '0').slice(0, 6)
+  const value = Number.parseInt(hex, 16)
+  return [
+    ((value >> 16) & 255) / 255,
+    ((value >> 8) & 255) / 255,
+    (value & 255) / 255,
+  ] as const
+}
