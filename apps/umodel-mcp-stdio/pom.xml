<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.umodel</groupId>
        <artifactId>umodel-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>umodel-mcp-stdio</artifactId>
    <name>UModel MCP Stdio</name>

    <dependencies>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-agentgateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-bootstrap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-entitystore</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-graphstore-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-graphstore-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-graphstore-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-graphstore-ladybug</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-query</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-sampledata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.umodel</groupId>
            <artifactId>umodel-workspace</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.alibaba.umodel.mcpstdio.UModelMcpStdioApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
