Date: Tue, 30 Jun 2026 17:01:42 +0800
Subject: [PATCH] Fix OModel draft diff detection

---
 src/features/umodel/model.ts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/features/umodel/model.ts b/src/features/umodel/model.ts
index f613db4..167d580 100644
--- a/src/features/umodel/model.ts
+++ b/src/features/umodel/model.ts
@@ -463,6 +463,7 @@ function stableStringify(value: unknown): string {
   if (Array.isArray(value)) return `[${value.map(stableStringify).join(',')}]`
   if (isObject(value)) {
     return `{${Object.keys(value)
+      .filter((key) => value[key] !== undefined)
       .sort()
       .map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`)
       .join(',')}}`
