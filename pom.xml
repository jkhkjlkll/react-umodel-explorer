<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.alibaba.umodel</groupId>
    <artifactId>umodel-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>UModel Java Backend</name>
    <description>JDK 21 Spring Boot backend implementation track for UModel.</description>

    <modules>
        <module>modules/contract</module>
        <module>modules/graphstore-api</module>
        <module>modules/graphstore-memory</module>
        <module>modules/graphstore-file</module>
        <module>modules/graphstore-ladybug</module>
        <module>modules/workspace</module>
        <module>modules/umodel</module>
        <module>modules/entitystore</module>
        <module>modules/query</module>
        <module>modules/agentgateway</module>
        <module>modules/sampledata</module>
        <module>modules/bootstrap</module>
        <module>apps/umodel-server</module>
        <module>apps/umodel-mcp-stdio</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>
</project>
